{
  // Ready-to-run environment for trying Koito in a GitHub Codespace:
  // Go 1.25, Node 22 with Yarn, and libvips for image processing.
  // Start the demo with:  scripts/demo.sh
  "name": "Koito",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/go:1": { "version": "1.25" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [4110],
  "portsAttributes": {
    "4110": { "label": "Koito", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["golang.go"] }
  }
}
